# Servidor
# PORT é gerenciado automaticamente pela Vercel — não defina em produção.
# Usado apenas em desenvolvimento local (yarn dev).
PORT=3000
NODE_ENV=staging

# Pagar.me (use ak_test_ para staging)
PAGARME_API_KEY=ak_test_...
PAGARME_PLATFORM_RECIPIENT_ID=re_...
PLATFORM_FEE_PERCENT=15

# Expo Push Notifications
EXPO_ACCESS_TOKEN=...

# Google Sign-In
# O token é verificado pelo Supabase — configure o Google Provider em:
# Supabase Dashboard > Authentication > Providers > Google
# Client ID: type "Web application" em console.cloud.google.com
# GOOGLE_CLIENT_SECRET não é mais necessário (sem code exchange)
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Admin
# Chave secreta para o painel amparo-admin (gere uma string aleatória longa)
ADMIN_SECRET=uma-chave-longa-e-aleatoria-aqui
