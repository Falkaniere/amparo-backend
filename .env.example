SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNzcXRyc2R4eGV4b21weWl4bHhvIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3NzU2Mjg3MSwiZXhwIjoyMDkzMTM4ODcxfQ.wrgeDqsjjq_KAKEh3Rq_gSlywVHcRC6KZQDwdA_-8Ck

# Servidor
PORT=3000
NODE_ENV=staging

# Pagar.me (use ak_test_ para staging)
PAGARME_API_KEY=ak_test_...
PAGARME_PLATFORM_RECIPIENT_ID=re_...
PLATFORM_FEE_PERCENT=15

# Expo Push Notifications
EXPO_ACCESS_TOKEN=...

# Google Sign-In
# O token é verificado pelo Supabase — configure o Google Provider em:
# Supabase Dashboard > Authentication > Providers > Google
# Client ID: type "Web application" em console.cloud.google.com
# GOOGLE_CLIENT_SECRET não é mais necessário (sem code exchange)
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Admin
# Chave secreta para o painel amparo-admin (fallback opcional — o login agora é
# feito por e-mail/senha no Firebase). Gere uma string aleatória longa.
ADMIN_SECRET=uma-chave-longa-e-aleatoria-aqui

# Lista de e-mails (separados por vírgula) autorizados a acessar o painel admin.
# Apenas usuários do Firebase com esses e-mails conseguem entrar.
ADMIN_EMAILS=admin@amparo.com,outro-admin@amparo.com

# Firebase Admin — usado para validar o login do painel amparo-admin.
# Firebase Console > Project Settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=amparo-xxxxx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@amparo-xxxxx.iam.gserviceaccount.com
# Cole a private_key entre aspas, mantendo os \n (ou as quebras de linha reais)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
